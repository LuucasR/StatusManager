generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  // Van al final, en orden de incorporacion: ALTER TYPE ... ADD VALUE appendea
  // al final del orden fisico en Postgres, y ponerlos en el medio haria
  // divergir el orden logico del fisico. El orden de PRESENTACION vive en
  // ROLE_ORDER (frontend/src/components/roles.ts), no aca.
  SUPERVISOR
  TASK_MANAGER
}

enum ActivityStatus {
  AVAILABLE
  WORKING
  BREAK
  LUNCH
  MEETING
  OFFLINE
  DISCONNECTED
}

enum TaskState {
  PENDING
  IN_PROGRESS
  DONE
}

enum PasswordChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationKind {
  DIRECT
  GENERAL
  TASK
}

enum NotificationType {
  TASK_ADDED
  TASK_REMOVED
  TASK_STATE
  TASK_MESSAGE
}

model Employee {
  id             Int              @id @default(autoincrement())
  employeeNumber Int              @unique
  name           String
  email          String           @unique
  password       String
  role           Role             @default(EMPLOYEE)
  currentStatus  ActivityStatus   @default(OFFLINE)
  statusSince    DateTime         @default(now())
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  activities     ActivityHistory[]
  passwordChangeRequests PasswordChangeRequest[]

  createdTasks       Task[]            @relation("TaskCreator")
  taskParticipations TaskParticipant[]

  conversations ConversationMember[]
  messages      Message[]
  notifications Notification[]
}

model PasswordChangeRequest {
  id                Int                         @id @default(autoincrement())
  employeeId        Int
  requestedPassword String
  status            PasswordChangeRequestStatus @default(PENDING)
  createdAt         DateTime                    @default(now())
  resolvedAt        DateTime?
  employee          Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([employeeId, status])
}

model ActivityHistory {
  id         Int            @id @default(autoincrement())
  employeeId Int
  status     ActivityStatus
  detail     String
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Tarea declarada al pasar a WORKING. SetNull: borrar una tarea no puede
  /// borrar el tiempo que alguien le imputo.
  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Snapshot del titulo, mismo criterio que Conversation.title y
  /// Message.authorName: el resumen tiene que seguir diciendo en que se
  /// trabajo aunque la tarea ya no exista.
  taskTitle String?

  @@index([employeeId, startedAt])
  @@index([startedAt])
  @@index([taskId])
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  state       TaskState @default(PENDING)
  startsAt    DateTime
  endsAt      DateTime
  pinned      Boolean   @default(false)
  createdById Int?
  createdBy   Employee? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants TaskParticipant[]

  conversation  Conversation?
  notifications Notification[]
  activities    ActivityHistory[]

  @@index([state, startsAt])
  @@index([startsAt])
  @@index([pinned, endsAt])
}

model TaskParticipant {
  taskId     Int
  employeeId Int
  addedAt    DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@index([employeeId])
}

model Conversation {
  id   Int              @id @default(autoincrement())
  kind ConversationKind
  /// Idempotencia del get-or-create: "general" | "d:<minId>:<maxId>" | "t:<taskId>"
  key  String           @unique
  /// Snapshot del titulo: sobrevive al borrado de la tarea
  title  String?
  closed Boolean @default(false)
  taskId Int?    @unique
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId Int
  employeeId     Int
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([conversationId, employeeId])
  @@index([employeeId])
}

model Message {
  id             Int  @id @default(autoincrement())
  conversationId Int
  authorId       Int?
  /// Snapshot: el historial tiene que seguir diciendo QUIEN hablo aunque
  /// borren la cuenta. Por eso authorId es SetNull y no Cascade.
  authorName     String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       Employee?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, id])
}

model Notification {
  id         Int              @id @default(autoincrement())
  employeeId Int
  type       NotificationType
  title      String
  body       String
  taskId     Int?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([employeeId, readAt])
}
