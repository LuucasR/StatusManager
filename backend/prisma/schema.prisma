generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  // These go at the end, in the order they were introduced: ALTER TYPE ... ADD
  // VALUE appends to the end of the physical order in Postgres, and putting
  // them in the middle would make the logical order diverge from the physical
  // one. The PRESENTATION order lives in ROLE_ORDER
  // (frontend/src/components/roles.ts), not here.
  SUPERVISOR
  TASK_MANAGER
}

enum ActivityStatus {
  AVAILABLE
  WORKING
  BREAK
  LUNCH
  MEETING
  OFFLINE
  DISCONNECTED
  /// Set by the end-of-day check when someone working does not answer.
  ///
  /// Deliberately NOT the same value as DISCONNECTED: that one means the tab
  /// was closed and is hidden from history on purpose, whereas this one is the
  /// finding the whole check exists to record. Reusing DISCONNECTED would have
  /// filed the result of the control into the one status the reports ignore.
  /// Appended at the end for the same reason the Role values are.
  AUTO_DISCONNECTED
}

enum TaskState {
  PENDING
  IN_PROGRESS
  DONE
}

enum PasswordChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationKind {
  DIRECT
  GENERAL
  TASK
}

enum NotificationType {
  TASK_ADDED
  TASK_REMOVED
  TASK_STATE
  TASK_MESSAGE
  /// Someone was auto-disconnected for not answering the end-of-day check.
  ACTIVITY_NO_RESPONSE
}

model Employee {
  id                     Int                     @id @default(autoincrement())
  employeeNumber         Int                     @unique
  name                   String
  email                  String                  @unique
  password               String
  /// Forces a password change on next login. Set when an admin resolves a
  /// reset request, because the temporary password is spoken out loud.
  mustChangePassword     Boolean                 @default(false)
  /// Tokens issued before this instant are rejected. Without it, changing a
  /// password left every already-issued JWT valid for up to a day.
  passwordChangedAt      DateTime?
  /// When they last answered an activity check.
  ///
  /// Persisted rather than held in memory so the check can tell who answered
  /// even if the process restarted mid-window. Compared against
  /// `lastPromptedAt`: an answer counts only if it came AFTER the question.
  lastConfirmedAt        DateTime?
  /// When the app last asked them whether they were still working.
  ///
  /// This is what makes the off-hours check both recurrent and restart-proof.
  /// The interval is measured from here, so the cadence cannot drift, and the
  /// answer timeout is re-derivable from the database after a restart drops the
  /// in-process timer. Null means never asked, which is due immediately.
  lastPromptedAt         DateTime?
  /// Consecutive activity checks that found nobody listening.
  ///
  /// A single miss no longer disconnects. On the web "no socket" reliably means
  /// "no tab open", but on Android the OS tears the socket down about a minute
  /// after the screen goes off, so an employee who pocketed their phone looked
  /// exactly like one who had gone home - and was disconnected without ever
  /// being asked. Two consecutive misses are required instead, which costs one
  /// recheck interval of accuracy and buys the whole mobile app.
  ///
  /// Reset by anything that proves they are there: answering a check, changing
  /// their own status, or simply being reachable when the check runs.
  missedChecks           Int                     @default(0)
  role                   Role                    @default(EMPLOYEE)
  currentStatus          ActivityStatus          @default(OFFLINE)
  statusSince            DateTime                @default(now())
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  activities             ActivityHistory[]
  passwordChangeRequests PasswordChangeRequest[]

  createdTasks       Task[]            @relation("TaskCreator")
  taskParticipations TaskParticipant[]

  checklistAssignments TaskChecklistItem[] @relation("ChecklistAssignee")
  checklistCompletions TaskChecklistItem[] @relation("ChecklistCompleter")

  conversations ConversationMember[]
  messages      Message[]
  notifications Notification[]

  attendanceEntries  AttendanceEntry[] @relation("AttendanceEmployee")
  attendanceRecorded AttendanceEntry[] @relation("AttendanceRecorder")
}

/// A request to have the password reset. It deliberately carries NO password:
/// the employee does not choose one and nothing reversible is ever stored. On
/// approval the server mints a random temporary password, saves only its hash
/// and returns the cleartext to the admin exactly once.
model PasswordChangeRequest {
  id         Int                         @id @default(autoincrement())
  employeeId Int
  status     PasswordChangeRequestStatus @default(PENDING)
  createdAt  DateTime                    @default(now())
  resolvedAt DateTime?
  employee   Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([employeeId, status])
}

model ActivityHistory {
  id         Int            @id @default(autoincrement())
  employeeId Int
  status     ActivityStatus
  detail     String
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Task declared when switching to WORKING. SetNull: deleting a task must not
  /// delete the time somebody booked against it.
  taskId    Int?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Title snapshot, same reasoning as Conversation.title and
  /// Message.authorName: the summary has to keep saying what was worked on even
  /// once the task no longer exists.
  taskTitle String?

  @@index([employeeId, startedAt])
  @@index([startedAt])
  @@index([taskId])
}

model Task {
  id                      Int       @id @default(autoincrement())
  title                   String
  description             String
  state                   TaskState @default(PENDING)
  startsAt                DateTime
  endsAt                  DateTime
  pinned                  Boolean   @default(false)
  /// Stamped when the end-of-day job moves a task out of IN_PROGRESS, cleared
  /// when the next working morning puts it back.
  ///
  /// The flag is what makes the pair reversible: at 09:00 the state alone
  /// cannot tell a task the job paused last night from one nobody ever started,
  /// and resuming every PENDING task would start work on its own.
  autoPausedAt            DateTime?
  /// Move the task to DONE on its own once the last checklist item is ticked.
  ///
  /// Per task and not a global rule: a checklist can be the whole of the work,
  /// or a partial reminder with something still unwritten left to do. Deciding
  /// it when the task is created is the only thing that tells those two apart.
  autoCompleteOnChecklist Boolean   @default(false)
  createdById             Int?
  createdBy               Employee? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  participants TaskParticipant[]
  checklist    TaskChecklistItem[]

  conversation  Conversation?
  notifications Notification[]
  activities    ActivityHistory[]

  @@index([state, startsAt])
  @@index([startsAt])
  @@index([pinned, endsAt])
}

model TaskParticipant {
  taskId     Int
  employeeId Int
  addedAt    DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@index([employeeId])
}

/// One line of a task's checklist: "clean the menu", "clean the leftover assets".
///
/// Cascade like TaskParticipant: an item has no life of its own outside the task.
model TaskChecklistItem {
  id         Int       @id @default(autoincrement())
  taskId     Int
  text       String
  done       Boolean   @default(false)
  doneAt     DateTime?
  /// Who ticked it. SetNull rather than Cascade: deleting an account must not
  /// delete the work it recorded.
  doneById   Int?
  doneBy     Employee? @relation("ChecklistCompleter", fields: [doneById], references: [id], onDelete: SetNull)
  /// Name snapshot, same reasoning as Message.authorName: "done by" is a fact
  /// about the past and has to stay readable once the account is gone.
  doneByName String?
  /// Who is in charge of this one. Always one of the task's participants, which
  /// the routes enforce - there is no database constraint that can express
  /// "exists in TaskParticipant for THIS task".
  ///
  /// Deliberately NOT snapshotted the way doneByName is: an assignment to a
  /// deleted account is stale rather than historical, and should read as nobody
  /// being in charge so somebody picks it up.
  assigneeId Int?
  assignee   Employee? @relation("ChecklistAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Explicit ordering, unlike TaskParticipant, which is read back by addedAt.
  /// A checklist's order is the one the author typed and can reorder while
  /// editing, so it cannot be derived from when the row was inserted.
  ///
  /// Deliberately NOT unique on (taskId, position): reordering would then need
  /// a two-phase update to avoid colliding with the index halfway through.
  position   Int
  createdAt  DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@index([assigneeId])
}

model Conversation {
  id     Int              @id @default(autoincrement())
  kind   ConversationKind
  /// get-or-create idempotency: "general" | "d:<minId>:<maxId>" | "t:<taskId>"
  key    String           @unique
  /// Title snapshot: survives the task being deleted
  title  String?
  closed Boolean          @default(false)
  taskId Int?             @unique
  task   Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId Int
  employeeId     Int
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([conversationId, employeeId])
  @@index([employeeId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  authorId       Int?
  /// Snapshot: the history has to keep saying WHO spoke even after the account
  /// is deleted. That is why authorId is SetNull and not Cascade.
  authorName     String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       Employee?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, id])
}

/**
 * One row per recurring job, holding the last working day it ran.
 * Kept in the database rather than in memory because that buys three things a
 * bare setInterval does not: the job still runs after a restart that straddled
 * its scheduled time (catch-up), it cannot run twice in one day, and a second
 * instance cannot duplicate it, since claiming the day is a single conditional
 * UPDATE.
 */
model ScheduledJobRun {
  job       String   @id
  /// Working day already processed, as YYYY-MM-DD in the configured timezone.
  /// A date string and not a DateTime: the question is always "did this run
  /// today, in the team's timezone", and storing an instant would make that a
  /// conversion on every read instead of a string compare.
  lastRunOn String
  ranAt     DateTime @default(now())
}

/**
 * Single-row configuration for the working day, editable by an admin.
 * A typed single row rather than a key/value table so the times keep their
 * shape and a typo cannot be stored as a valid setting.
 */
model WorkdaySettings {
  /// Always 1. Enforced by the routes, which only ever upsert this id.
  id                         Int      @id @default(1)
  /// Weekdays that are working days, 0 = Sunday .. 6 = Saturday.
  /// Replaces what used to be a hardcoded Monday-to-Friday check.
  workingWeekdays            Int[]    @default([1, 2, 3, 4, 5])
  /// HH:MM in `timezone`. Resume paused tasks at this time.
  startTime                  String   @default("09:00")
  /// HH:MM in `timezone`. Run the activity check and pause tasks at this time.
  endTime                    String   @default("17:30")
  timezone                   String   @default("America/Argentina/Buenos_Aires")
  /// Minutes to wait AFTER endTime before asking whoever is still working.
  /// Distinct from the timeout below: this is the grace period before the
  /// question, that is how long they then have to answer it.
  confirmationDelayMinutes   Int      @default(0)
  /// Seconds someone has to accept the check before being auto-disconnected.
  confirmationTimeoutSeconds Int      @default(120)
  /// Minutes between checks while someone is still WORKING out of hours.
  ///
  /// The check is not a one-off at the end of the day: as long as the status
  /// claims active work outside the calendar's hours, the question comes back
  /// this often - through the night, the weekend and a holiday alike.
  recheckIntervalMinutes     Int      @default(30)
  /// Master switch, so the automation can be stopped without a deploy.
  enabled                    Boolean  @default(true)
  /// Total late minutes allowed from the 1st to the 15th of the month.
  lateToleranceFirstHalfMinutes  Int  @default(25)
  /// Total late minutes allowed from the 16th to the end of the month.
  lateToleranceSecondHalfMinutes Int  @default(25)
  updatedAt                  DateTime @updatedAt
}

/**
 * One day's arrival time for one employee, typed in by an admin.
 *
 * `expectedStart` and `lateMinutes` are snapshots taken when the entry is saved:
 * editing the calendar later must not rewrite how late somebody was on a day
 * that already happened. The tolerance is NOT snapshotted - it is the rule the
 * half-month is judged by, so changing it re-evaluates the summary.
 */
model AttendanceEntry {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  /// "YYYY-MM-DD", a local calendar date, same reasoning as WorkdayException.date.
  date          String
  /// "HH:MM" as typed.
  arrivedAt     String
  /// "HH:MM" the day started at when this was saved, exceptions included.
  expectedStart String
  lateMinutes   Int
  note          String?
  /// Who typed it. SetNull: deleting that account must not delete the record.
  createdById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee  Employee  @relation("AttendanceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy Employee? @relation("AttendanceRecorder", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
}

/**
 * One dated deviation from the weekly pattern.
 * Covers all three cases with one row: `working: false` closes the day (a
 * holiday), `working: true` opens one the weekly pattern would have closed (a
 * worked Saturday), and the optional times make it a half day.
 */
model WorkdayException {
  /// "YYYY-MM-DD" as read in the configured timezone.
  ///
  /// Text and not DateTime on purpose: a holiday is a local CALENDAR DATE,
  /// not an instant. Stored as a timestamp it would land on the previous or
  /// next day depending on the offset, and the whole feature keys off
  /// comparing it to what zonedNow() reports. ScheduledJobRun.lastRunOn
  /// already stores a day this way for the same reason.
  date      String   @id
  /// false = closed. true = working, overriding the weekly pattern.
  working   Boolean
  /// HH:MM overrides. Null inherits WorkdaySettings.
  startTime String?
  endTime   String?
  /// Shown in the calendar cell, e.g. "Feriado nacional".
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id         Int              @id @default(autoincrement())
  employeeId Int
  type       NotificationType
  title      String
  body       String
  taskId     Int?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([employeeId, readAt])
}
