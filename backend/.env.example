# Validated at boot by src/env.ts. A missing required variable now kills the
# process on startup instead of surfacing at the first request that needs it.

# Required.
DATABASE_URL="postgresql://user:password@localhost:5432/statusmanager"
# Required. Use at least 32 random characters: it signs every session token.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional. Origin allowed by CORS and by the Socket.IO handshake; localhost is
# always allowed, so this only matters once the frontend is deployed.
FRONTEND_URL="http://localhost:5173"
# Optional, defaults to 3000.
PORT=3000
# Optional: development | test | production. Defaults to development.
NODE_ENV=development
# Optional: pino level (trace|debug|info|warn|error|fatal|silent).
# Defaults to info in production, debug elsewhere.
LOG_LEVEL=debug

# Only read by prisma/seed.ts, never by the server.
# NOTE: the seed upserts on every run, so it resets the admin password to this
# value each time it is executed.
ADMIN_EMAIL="admin@statusmanager.local"
ADMIN_PASSWORD="Admin123!"
