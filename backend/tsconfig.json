{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"]
  },

  "include": ["src"],

  // Tests run through tsx, which type-checks them on the way; they have no
  // business in the deployed dist/.
  "exclude": ["src/**/*.test.ts"]
}